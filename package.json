{
  "name": "dance-to-art",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "api"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "fetch-models": "node scripts/fetch-models.mjs",
    "build:api": "esbuild api/_src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.js"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "esbuild": "0.28.2"
  }
}
