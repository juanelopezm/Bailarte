CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Vision analysis on the hosted deployment only (the local `claude` CLI can't run in a
# serverless function) — reuses the same Cloudflare account/token above, no separate signup.
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# --- Vercel-hosted deployment only (not needed for local LAN party mode) ---

# Realtime (replaces the LAN WebSocket hub): create a free app at https://dashboard.pusher.com
# (Channels product). VITE_PUSHER_KEY/CLUSTER are safe to expose to the browser; APP_ID/SECRET
# are server-only. Leave all four blank for local LAN dev — the client auto-falls-back to the
# WebSocket transport when VITE_PUSHER_KEY is unset.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

# Gallery + battle persistence (replaces the local gallery.json file): add the "Upstash for
# Redis" integration from the Vercel Marketplace to your project — it injects these
# automatically (as KV_REST_API_URL/TOKEN; @upstash/redis's Redis.fromEnv() reads either name).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Artifact storage (replaces server/data/artifacts/): create a Blob store under Vercel's Storage
# tab and link it to the project — it injects this automatically.
BLOB_READ_WRITE_TOKEN=
